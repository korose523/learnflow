# 本地开发时由 Vite 代理到后端；线上部署时设置为完整 HTTPS API 地址。
VITE_API_BASE=/api/v1

# ── 开发期快捷登录凭据（可选）────────────────────────────────────────────
# LoginPage 在**开发模式**下点击角色卡片时会自动填入以下凭据，省去手输。
# 这些变量**只对开发有意义**：生产构建（vite build）下快捷登录整体不生效。
#
# ⚠️ 请勿把真实口令写进本文件（本文件入版本库）。正确做法是复制为
#    `.env.local`（已被 .gitignore 忽略）再填写：
#        cp .env.example .env.local
#
# 口令必须与后端 `learnflow-backend/.env` 的 SEED_*_PASSWORD 一致 ——
# 后端启动时会把演示账号口令同步为该值。
#
# VITE_DEMO_STUDENT_EMAIL=student@learnflow.com
# VITE_DEMO_STUDENT_PASSWORD=
# VITE_DEMO_TEACHER_EMAIL=teacher@learnflow.com
# VITE_DEMO_TEACHER_PASSWORD=
# VITE_DEMO_PARENT_EMAIL=parent_student@learnflow.com
# VITE_DEMO_PARENT_PASSWORD=
# VITE_DEMO_ADMIN_EMAIL=admin@learnflow.com
# VITE_DEMO_ADMIN_PASSWORD=
