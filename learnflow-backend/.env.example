# LearnFlow 环境配置模板
# 复制此文件为 .env 并根据实际环境修改

# 数据库
DATABASE_URL=mysql+aiomysql://learnflow:learnflow@localhost:3306/learnflow

# Redis 缓存
REDIS_URL=redis://localhost:6379/0

# JWT 密钥（不设置将自动生成随机密钥，每次重启变化）
# JWT_SECRET_KEY=your-super-secret-random-key-here

# 运行模式
DEBUG=true
ENVIRONMENT=development

# 种子数据密码（可选，不设置将自动生成随机密码）
# SEED_ADMIN_PASSWORD=secure-admin-password
# SEED_TEACHER_PASSWORD=secure-teacher-password
# SEED_STUDENT_PASSWORD=secure-student-password
# SEED_PARENT_PASSWORD=secure-parent-password
