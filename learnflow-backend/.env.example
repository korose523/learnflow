# LearnFlow 环境配置模板
# 复制此文件为 .env 并根据实际环境修改

# 数据库：本地开发默认使用 SQLite，无需单独安装数据库。
# 生产环境请改为受管数据库连接串，并做好备份、加密与访问控制。
DATABASE_URL=sqlite+aiosqlite:///./learnflow.dev.db

# Redis 缓存
REDIS_URL=redis://localhost:6379/0

# JWT 密钥：开发环境未设置时会临时生成；生产环境必须显式设置一个稳定的随机密钥。
# JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production

# 允许访问 API 的前端来源。Pydantic 使用 JSON 数组格式解析。
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 运行模式
DEBUG=true
ENVIRONMENT=development

# 仅限本地演示。生产环境和研究正式采集环境必须保持 false。
DEMO_DATA_ENABLED=false

# 种子数据密码（仅在 DEMO_DATA_ENABLED=true 或手动执行 seed.py 时使用）。
# 建议通过本机环境变量或未提交的 .env 填入，不要写入仓库。
# SEED_ADMIN_PASSWORD=secure-admin-password
# SEED_TEACHER_PASSWORD=secure-teacher-password
# SEED_STUDENT_PASSWORD=secure-student-password
# SEED_PARENT_PASSWORD=secure-parent-password
#
# 口令轮换：应用启动时会校验演示账号的 hash 是否与上述值一致，不一致则**自动更新**。
# 因此轮换只需改这里（并同步前端 .env.local 的 VITE_DEMO_*_PASSWORD 以保留
# 开发期快捷登录），无需删库重建账号。
#
# ⚠️ 切勿使用文档、README 或示例代码中出现过的口令。历史上演示口令曾是公开值，
#    任何沿用旧值的部署都应视为已泄露。
